{
  "name": "io.github.tekinozbek.utilities",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart io.github.tekinozbek.utilities\"",
    "pack": "npm run build && streamdeck pack io.github.tekinozbek.utilities.sdPlugin",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "vendor:sdpi": "node ../scripts/vendor-sdpi.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.4.0",
    "@elgato/utils": "0.6.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "~20.15.0",
    "rollup": "^4.0.0",
    "tslib": "^2.6.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  }
}
